# raglite configuration — copy to .env and adjust. All values are optional.

# Host port the service is published on (always bound to 127.0.0.1 only).
RAGLITE_PORT=8000

# Path INSIDE the container where the SQLite index file lives. /data is a named
# volume (raglite-data), so the index survives container rebuilds. For a plain
# `raglite serve` run, use a local path like ./data/index.db (default: in-memory).
RAGLITE_INDEX_PATH=/data/index.db

# Built-in web UI: 1 = serve the single-page UI at / (default), 0 = pure JSON API.
RAGLITE_UI=1

# Dimension of the built-in hashing embedder's vectors. Only change if you know
# why you need it; changing it invalidates nothing (vectors are re-derived).
RAGLITE_EMBEDDING_DIM=256
